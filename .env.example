# ==============================================================================
# SHAHYA PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL - Supabase / Neon / AWS RDS / Render)
# ------------------------------------------------------------------------------
# In prisma/schema.prisma change provider to "postgresql":
# datasource db {
#   provider = "postgresql"
#   url      = env("DATABASE_URL")
# }
# Then run: npx prisma db push
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SESSION & JWT SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET="generate-a-super-secret-random-32-character-string-here"
NEXT_PUBLIC_APP_URL="https://shahya.com"
NEXT_PUBLIC_APP_NAME="Shahya"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (Google Cloud Console)
# ------------------------------------------------------------------------------
# Create OAuth 2.0 Client ID in https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# ------------------------------------------------------------------------------
# 4. FIREBASE PHONE OTP AUTHENTICATION (Firebase Console)
# ------------------------------------------------------------------------------
# Enable Phone Authentication in https://console.firebase.google.com -> Build -> Authentication -> Sign-in method -> Phone
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef..."

# Firebase Admin SDK (Project Settings -> Service Accounts -> Generate New Private Key)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 5. CLOUD STORAGE FOR LISTING PHOTOS (Cloudinary / AWS S3 / Supabase Storage)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"
